# ---- generation ------------------------------------------------------------
# Optional. Without a key the assistant runs in extractive mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- retrieval -------------------------------------------------------------
# Set to "off" to skip dense retrieval and use BM25 only.
GROUNDTRUTH_EMBEDDINGS=on
# GROUNDTRUTH_MODEL_CACHE=./.cache/transformers

# ---- Confluence ------------------------------------------------------------
# CONFLUENCE_BASE_URL=https://company.atlassian.net
# CONFLUENCE_EMAIL=automation@company.com
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE_KEYS=OPS,QA
# CONFLUENCE_CQL=
# CONFLUENCE_MAX_PAGES=1000

# ---- SharePoint (Microsoft Graph) -----------------------------------------
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=contoso.sharepoint.com,site-guid,web-guid
# SHAREPOINT_SITE_HOSTNAME=contoso.sharepoint.com
# SHAREPOINT_SITE_PATH=/sites/Operations
# SHAREPOINT_DRIVE_ID=
# SHAREPOINT_MAX_ITEMS=1000

# ---- Google Drive ----------------------------------------------------------
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
# GOOGLE_DRIVE_ACCESS_TOKEN=
# GOOGLE_DRIVE_MAX_ITEMS=1000
